{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/openapi/:path*", "destination": "/api/openapi/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/openapi/[...path].ts": {
      "maxDuration": 30
    }
  }
}
