# ============================================================
#  미세먼지 통계·현황 앱 — 환경변수 예시
#  이 파일을 복사해 `.env.local` 로 만들고 값을 채워 넣으세요.
#     cp .env.example .env.local
#  .env.local 은 .gitignore 에 포함되어 커밋되지 않습니다.
# ============================================================

# [필수] 공공데이터포털(data.go.kr) 일반 인증키 — "Decoding" 값을 그대로 붙여넣으세요.
#   발급처 : https://www.data.go.kr
#   활용신청이 필요한 오픈API (3건, 모두 동일한 인증키 사용)
#     1) 한국환경공단_에어코리아_대기오염정보        (ArpltnInforInqireSvc)
#     2) 한국환경공단_에어코리아_측정소정보          (MsrstnInfoInqireSvc)
#     3) 한국환경공단_에어코리아_대기오염통계현황     (ArpltnStatsSvc)
#   ※ Encoding 키(%2B, %3D 가 섞인 값)가 아니라 Decoding 키를 넣어야 합니다.
#   ※ 변수명에 VITE_ 접두사를 붙이지 마세요. 붙이면 키가 클라이언트 번들에 포함되어
#      브라우저 네트워크 탭에 노출됩니다. 이 변수는 프록시(서버)에서만 사용됩니다.
AIRKOREA_SERVICE_KEY=

# [선택] 데이터 소스 강제 지정  auto | live | mock
#   auto : 인증키가 있으면 실데이터, 없으면 데모 데이터 (기본값)
#   live : 항상 실데이터 (키 없으면 오류 화면)
#   mock : 항상 데모 데이터 (오프라인 시연·발표용)
VITE_DATA_SOURCE=auto

# [선택] 앱 최초 진입 시 기본 시도
VITE_DEFAULT_SIDO=서울

# [선택] API 호출 타임아웃(ms) — 에어코리아 응답이 5~7초로 느려 여유를 둔다
VITE_API_TIMEOUT=15000
