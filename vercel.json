{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix app ci",
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/dist",
  "rewrites": [
    { "source": "/openapi/:path*", "destination": "/api/openapi/:path*" },
    { "source": "/((?!api/|openapi/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/openapi/[...path].ts": {
      "maxDuration": 10
    }
  }
}
